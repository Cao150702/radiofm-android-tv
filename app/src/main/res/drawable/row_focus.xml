<?xml version="1.0" encoding="utf-8"?>
<!-- 焦点态背景：给列表项用。
     电视上光标就是遥控器，没有鼠标悬停，必须让用户随时看清焦点落在哪一行。
     只做了 focused 态 —— pressed 由 ListView 自己叠加。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#22C62828" />
            <stroke android:width="4dp" android:color="#C62828" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#14C62828" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
