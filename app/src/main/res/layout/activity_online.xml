<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5EFE6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/online_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="搜索电台名（留空 = 按地区列出）"
            android:inputType="text"
            android:singleLine="true"
            android:textSize="14sp" />

        <Button
            android:id="@+id/online_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="搜索" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="地区："
            android:textSize="13sp" />

        <Button
            android:id="@+id/online_country"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:text="中国大陆" />

    </LinearLayout>

    <!-- 内置台的分类筛选（过滤应用自带的 1398 个台） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="4dp">

        <Button android:id="@+id/bi_central" style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="12sp" android:text="央广省级" />
        <Button android:id="@+id/bi_local" style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="12sp" android:text="省市县" />
        <Button android:id="@+id/bi_net" style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="12sp" android:text="网络" />
        <Button android:id="@+id/bi_hmt" style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="12sp" android:text="港澳台" />
        <Button android:id="@+id/bi_intl" style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="12sp" android:text="国际" />
    </LinearLayout>

    <ListView
        android:id="@+id/online_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#D7CCC8"
        android:dividerHeight="1dp"
        android:cacheColorHint="#00000000" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:textSize="11sp"
        android:textColor="#8D6E63"
        android:text="数据来自 radio-browser.info（公共目录）。已自动过滤 Android 4.4 不支持的视频/HLS 流。国内部分电台有防盗链，播不出来属正常。" />

</LinearLayout>
