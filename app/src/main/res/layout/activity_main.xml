<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5EFE6">

    <!-- ===== 收音机面板 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#6D4C41"
        android:padding="14dp">

        <TextView
            android:id="@+id/station_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="网络收音机"
            android:textColor="#FFF8E1"
            android:textSize="20sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="marquee" />

        <!-- 版权声明。放在应用名正下方，尺寸克制、不抢主标题。 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/copyright"
            android:textColor="#BCAAA4"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/station_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#D7CCC8"
            android:textSize="12sp"
            android:singleLine="true" />

        <!-- 调谐刻度盘 + 指针（老式收音机那种）。
     指针位置随播放状态移动（见 MainActivity.updateTuneNeedle）：
     播放时在刻度上缓慢左右游走、缓冲时停在中间、停止时回最左端。
     纯装饰 —— 不做真实频率映射，因为网络电台没有"频率"这个概念，
     硬编一个数字反而是假信息。 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="10dp"
            android:background="#FFF8E1">

            <!-- 这个 LinearLayout 就是刻度的实际绘制区，
                 Java 拿它的宽度来算指针位置（见 applyNeedle），
                 所以必须有 id。 -->
            <LinearLayout
                android:id="@+id/tune_track"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="10dp"
                android:paddingRight="10dp">
                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:background="#8D6E63" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:layout_marginTop="15dp"
                    android:background="#BCAAA4" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:layout_marginTop="15dp"
                    android:background="#BCAAA4" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:background="#8D6E63" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:layout_marginTop="15dp"
                    android:background="#BCAAA4" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:layout_marginTop="15dp"
                    android:background="#BCAAA4" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:background="#8D6E63" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:layout_marginTop="15dp"
                    android:background="#BCAAA4" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:layout_marginTop="15dp"
                    android:background="#BCAAA4" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:background="#8D6E63" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:layout_marginTop="15dp"
                    android:background="#BCAAA4" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:layout_marginTop="15dp"
                    android:background="#BCAAA4" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:background="#8D6E63" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:layout_marginTop="15dp"
                    android:background="#BCAAA4" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:layout_marginTop="15dp"
                    android:background="#BCAAA4" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            </LinearLayout>

            <ImageView
                android:id="@+id/tune_needle"
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:layout_gravity="start|center_vertical"
                android:layout_marginLeft="12dp"
                android:background="#C62828" />
        </FrameLayout>
    </LinearLayout>

    <!-- ===== 状态区 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#5D4037" />

        <TextView
            android:id="@+id/icy_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="13sp"
            android:textStyle="italic"
            android:textColor="#2E7D32"
            android:visibility="gone"
            android:singleLine="true"
            android:ellipsize="marquee" />
    </LinearLayout>

    <!-- ===== 控制按钮 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <Button
            android:id="@+id/btn_play"
            style="@style/BigButton"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/play" />

        <Button
            android:id="@+id/btn_stop"
            style="@style/BigButton"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:text="@string/stop" />

        <Button
            android:id="@+id/btn_fav"
            style="@style/BigButton"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:text="收藏" />
    </LinearLayout>

    <!-- ===== 过滤框 + 分类 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp">

        <EditText
            android:id="@+id/filter_box"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="搜索电台名 / 分类 / 地区"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true"
            android:textSize="14sp" />

        <!-- 428 个台不分类翻不动。竖屏是触摸场景，Spinner 点开就是系统列表。 -->
    </LinearLayout>

    <ListView
        android:id="@+id/station_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:divider="#D7CCC8"
        android:dividerHeight="1dp"
        android:cacheColorHint="#00000000"
        android:fastScrollEnabled="true"
        android:scrollbarStyle="outsideOverlay" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:textSize="11sp"
        android:textColor="#8D6E63"
        android:text="菜单键 → 浏览在线电台库 / 导入播放列表 / 设置"
        android:gravity="center" />

</LinearLayout>
