<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标（Android 8.0+）。
     前景用位图（mipmap-*/ic_launcher.png）—— 那张图的白色背景已经抠掉了，
     透明区域会透出下面的背景色。

     为什么必须有这个文件：没有它的话，8.0+ 的启动器会拿普通图标**垫一层白底**
     再裁形状 —— 用户看到的"图标有白背景"就是这么来的。

     前景缩放 0.62：自适应图标的画布是 108dp，但只有中间 72dp 是安全区，
     四周会被启动器按形状裁掉。图案本身已经带内边距，再缩一点保证天线、
     提手这些边缘不会被切到。 -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_bg" />
    <foreground>
        <inset android:drawable="@mipmap/ic_launcher"
               android:inset="19%" />
    </foreground>
</adaptive-icon>
