<?xml version="1.0" encoding="utf-8"?>
<!-- 通用样式（竖屏/手机用）。
     这些名字在 values-land/styles.xml 里也有一份，那边覆盖成电视尺寸 ——
     布局文件只引用名字，具体数值由系统按屏幕方向挑。
     这样布局 XML 不用复制两份，也不会出现「引用了不存在的 style」而崩溃。

     注意：基础版**不写 textSize**，让布局里的内联 textSize 生效（保持手机原样）。 -->
<resources>
    <style name="TvStationName" />
    <style name="TvStationMeta" />
    <style name="TvStatusText" />
    <style name="TvIcyText" />
    <style name="TvRowName" />
    <style name="TvRowSub" />

    <!-- 设置页 / 在线库用。基础版留空，竖屏下这些控件走标签自带属性，
         外观与改动前一致；横屏由 values-land/tv_styles.xml 覆盖成电视尺寸。 -->
    <style name="TvSectionTitle" />
    <style name="TvSectionNote" />
    <style name="TvCheckBox" />
    <style name="TvTimeButton" />
    <style name="TvTimeDisplay" />
    <style name="TvSmallButton" />
    <style name="TvPrimaryButton" />
    <style name="TvListHint" />
</resources>
